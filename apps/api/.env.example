# Copy to apps/api/.env for local development. That file is ignored by git.
# Production values live in the server environment, never in the repository.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Must use the postgresql+asyncpg:// driver. Matches infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://khidmat:khidmat_local_only@localhost:5432/khidmat

# Comma-separated. The frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Comma-separated. Host headers this API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Long random value, required when deployed. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# IP_HASH_SECRET=

# Only behind a trusted proxy. On Vercel: x-forwarded-for
# CLIENT_IP_HEADER=

# true on serverless hosts such as Vercel.
# DB_NULL_POOL=true

# Long random value, required when deployed. Encrypts CNIC numbers. Never change it afterwards.
# ENCRYPTION_KEY=

# Set on production to store uploads in S3. Without it, local development uses the .uploads folder.
# S3_BUCKET=
# S3_REGION=ap-southeast-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Long random value, required when deployed (at least 32 characters). Signs login tokens.
# JWT_SECRET=
