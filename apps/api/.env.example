# Copy to apps/api/.env for local development. That file is ignored by git.
# Production values live in the server environment, never in the repository.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Must use the postgresql+asyncpg:// driver. Matches infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://khidmat:khidmat_local_only@localhost:5432/khidmat

# Comma-separated. The frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Comma-separated. Host headers this API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Long random value, required when deployed. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# IP_HASH_SECRET=

# Only behind a trusted proxy. On Vercel: x-forwarded-for
# CLIENT_IP_HEADER=

# true on serverless hosts such as Vercel.
# DB_NULL_POOL=true

# Optional. Creates this admin when running: uv run python -m khidmat_api.seed
SEED_ADMIN_PHONE=
