# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables).
#
# Every NEXT_PUBLIC_* value is built into the public website. Anyone can read it.
# Never put passwords, API keys or tokens here.

# Full site URL, no trailing slash. Used for canonical links, social previews and the sitemap.
NEXT_PUBLIC_SITE_URL=https://khidmat-care.vercel.app

# Backend base URL, no trailing slash. On Vercel, use this site's own URL: vercel.json forwards
# /api to the backend, which keeps login cookies first-party.
NEXT_PUBLIC_API_URL=http://localhost:8001

# WhatsApp Business number: country code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Phone number patients can call, in international format.
NEXT_PUBLIC_PHONE=+923001234567

# "true" only on the real domain. Anything else adds noindex and blocks search engines.
NEXT_PUBLIC_ALLOW_INDEXING=false
